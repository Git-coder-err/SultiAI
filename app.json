{
  "expo": {
    "name": "SultiAI",
    "slug": "sultiai",
    "scheme": "sultiai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E6F9F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sultiai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1E6F9F"
      },
      "package": "com.sultiai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "microphonePermission": "SultiAI needs microphone access for voice conversations with your AI tutor."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SultiAI needs microphone access for voice conversations with your AI tutor."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "63c70aaa-c119-4a19-97a3-37a043ec0882"
      }
    }
  }
}
