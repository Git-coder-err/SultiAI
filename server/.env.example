# SultiAI Server Environment Configuration
# ========================================
# SultiAI uses Groq (cloud) for AI features.
# Set GROQ_API_KEY below to enable chat, transcription, and vision endpoints.
# Without a key, those endpoints return 503 with a clear error message.

# === REQUIRED: Groq API (for AI endpoints) ===
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === Server Settings ===
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# === Database ===
# SQLite (default) - no external DB needed
# DB_PATH=./sultiai.db

# MySQL (optional, for production with many users)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=
# MYSQL_DB=sultiai

# === Optional: xAI realtime voice mode ===
# XAI_API_KEY=
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE=eve
