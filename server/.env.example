# SultiAI Server Environment Configuration
# ========================================
# SultiAI runs WITHOUT API keys - all AI processing is local!
# 
# By default, SultiAI uses local ONNX models for:
# - LLM Chat: TinyLlama 1.1B (quantized, ~600MB)
# - Speech-to-Text: Whisper Tiny (quantized, ~300MB)
# - Text-to-Speech: Windows built-in voices (via msedge-tts)
#
# No API keys are required. All processing happens on the local machine.

# === OPTIONAL: Groq API (for faster responses if available) ===
# If you want to use Groq as a fallback/faster option, set your API key here.
# Without this, the server will use local ONNX models.
# GROQ_API_KEY=

# === Server Settings ===
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# === Local Model Settings ===
# Models are stored in the ./models directory
# Download models with: npm run models

# === Database ===
# SQLite (default) - no external DB needed
# DB_PATH=./sultiai.db

# MySQL (optional, for production with many users)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=
# MYSQL_DB=sultiai

# === Optional API Keys (for enhanced features) ===
# Only needed if you want faster cloud processing instead of local models
# XAI_API_KEY=   (for xAI realtime voice mode)
