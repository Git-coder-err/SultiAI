# Copy this file to .env and fill in your values.
# The TypeScript server (server/src) is the supported backend.

PORT=3001
JWT_SECRET=your-super-secret-jwt-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite (default) - DB_PATH defaults to ./sultiai.db
# DB_PATH=./sultiai.db
# DB_DIALECT=sqlite

# MongoDB (optional) - uncomment to enable alongside SQLite
# MONGODB_URI=mongodb://localhost:27017/sultiai

# MySQL (XAMPP) - optional alongside SQLite
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=
# MYSQL_DB=sultiai
