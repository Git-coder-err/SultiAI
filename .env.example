# Root-level env file for the Expo app.
# Copy this file to `.env` in the project root and edit it to match your setup.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle when you
# run `npx expo start` or build the app. Do not put secrets here.

# Backend server address used by the app.
# - Android emulator (same PC as the server): http://10.0.2.2:3001
# - iOS simulator / web (same PC as the server): http://localhost:3001
# - Physical device (same Wi-Fi as the PC running the server): http://<SERVER-LAN-IP>:3001
# If unset, the app falls back to 10.0.2.2 (Android) / localhost (others).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001
